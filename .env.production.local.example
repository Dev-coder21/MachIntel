# ========================================================
# MachIntel Local Production Configuration Template
# ========================================================
# Copy this file to .env.production.local to run MachIntel
# in local production mode (strict validation, debug disabled).
#
#   cp .env.production.local.example .env.production.local
#

# Application Environment (Enforces strict production validation)
ENVIRONMENT=production
DEBUG=false

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://machintel_user:machintel_password@postgres:5432/machintel
POSTGRES_USER=machintel_user
POSTGRES_PASSWORD=machintel_password
POSTGRES_DB=machintel

# Security & Authentication (MUST be at least 32 characters in production)
SECRET_KEY=change-this-to-a-cryptographically-secure-random-32-byte-secret-key-machintel
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (Wildcards strictly forbidden in production)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NODE_ENV=production

# AI Inspector Configuration
AI_INSPECTOR_PROVIDER=mock
AI_INSPECTOR_MODEL=gpt-4o
AI_INSPECTOR_MAX_TOOL_CALLS=5
AI_INSPECTOR_TIMEOUT_SECONDS=30

# Background Workers & Infrastructure
WORKER_ENABLED=true
SCHEDULER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_STALE_JOB_TIMEOUT_SECONDS=120
WORKER_MAX_ATTEMPTS=3

# Scheduled Job Periodic Intervals (Seconds)
SCHEDULE_EVIDENCE_REFRESH_INTERVAL=300
SCHEDULE_RISK_REFRESH_INTERVAL=180
SCHEDULE_MAINTENANCE_REFRESH_INTERVAL=300
SCHEDULE_ANALYTICS_REFRESH_INTERVAL=600
