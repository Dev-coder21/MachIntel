# ==========================================
# MachIntel Local Environment Configuration
# ==========================================
# Copy to .env for local development overrides:
#   cp .env.example .env

# Application Environment
ENVIRONMENT=development
DEBUG=true

# Database Configuration (PostgreSQL 16)
# Local native development:
DATABASE_URL=postgresql://devtrivedi@localhost:5432/machintel
# Docker Compose development:
# DATABASE_URL=postgresql://machintel_user:machintel_password@postgres:5432/machintel
POSTGRES_USER=machintel_user
POSTGRES_PASSWORD=machintel_password
POSTGRES_DB=machintel

# Security & Authentication
# Generate a secure 32+ character random string in production
SECRET_KEY=change-this-insecure-dev-key-to-a-secure-random-32-byte-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Bootstrap (Optional for script: backend/scripts/create_first_admin.py)
ADMIN_EMAIL=admin@machintel.io
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-secure-admin-password-min-8-chars

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# AI Inspector Configuration
# Available providers: mock, openai, anthropic (mock requires no API key)
AI_INSPECTOR_PROVIDER=mock
# AI_INSPECTOR_API_KEY=your-secure-llm-api-key-here
AI_INSPECTOR_MODEL=gpt-4o
# AI_INSPECTOR_BASE_URL=https://api.openai.com/v1
AI_INSPECTOR_MAX_TOOL_CALLS=5
AI_INSPECTOR_TIMEOUT_SECONDS=30

# M12 Workers & Background Infrastructure
WORKER_ENABLED=true
SCHEDULER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_STALE_JOB_TIMEOUT_SECONDS=120
WORKER_MAX_ATTEMPTS=3

# Scheduled Job Periodic Intervals (Seconds)
SCHEDULE_EVIDENCE_REFRESH_INTERVAL=300
SCHEDULE_RISK_REFRESH_INTERVAL=180
SCHEDULE_MAINTENANCE_REFRESH_INTERVAL=300
SCHEDULE_ANALYTICS_REFRESH_INTERVAL=600
